<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#ff4a4d56" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:startColor="#ff35373f" android:endColor="#ff23252b" android:angle="270.0" />
            <stroke android:width="1.0dip" android:color="#ff444750" />
        </shape>
    </item>
</selector>