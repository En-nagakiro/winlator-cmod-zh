<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ff4a4d56" />
            <corners android:radius="10.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#e326282f" android:endColor="#d91c1e24" android:angle="270.0" />
            <stroke android:width="1.0dip" android:color="#ff383b45" />
            <corners android:radius="10.0dip" />
        </shape>
    </item>
</selector>