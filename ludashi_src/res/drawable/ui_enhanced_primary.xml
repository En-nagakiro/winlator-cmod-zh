<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ff5c606a" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#ff4a4d56" android:endColor="#ff343740" android:angle="270.0" />
            <stroke android:width="1.0dip" android:color="#ff666a74" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
</selector>