            </HorizontalScrollView>
            <CheckBox android:id="@id/CBMouseMoveMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dip" android:text="@string/move_mouse_cursor_dragging" />
        </LinearLayout>
