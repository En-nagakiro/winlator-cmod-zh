        <SeekBar android:id="@id/SBOpacity" android:layout_width="fill_parent" android:layout_height="wrap_content" android:max="100" android:min="0" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8.0dip" android:text="@string/theme_color" />
